# Copy this file to .env and fill in the values before starting.
# cp .env.example .env

# Stream - iPhone IP Camera Lite URL
# Same Wi-Fi:  http://192.168.1.100:8080/video
STREAM_URL=http://192.168.1.100:8080/video

# Host model directory; Compose mounts it at /app/models in the container.
# Use an absolute path to share models with a local Python environment.
MODELS_DIR=./models
GEOMETRY_PROVIDER=r3
R3_CHECKPOINT=r3
R3_RESOLUTION=504
R3_BANK_SIZE=8
MAX_ACTIVE_KEYFRAMES=40
# Only used by the legacy GEOMETRY_PROVIDER=default frontend.
DEPTH_MODEL=vitb
HF_ENDPOINT=https://hf-mirror.com
DOWNSAMPLING=1.5

# SSH - paste output of: cat ~/.ssh/id_ed25519.pub
# Connect: ssh -p 2222 root@<server-ip>
SSH_PUBLIC_KEY=
